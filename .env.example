# Configuracion del Agente SRE con LiteLLM y Amazon Bedrock

# Modelo principal a utilizar mediante LiteLLM
# Opciones Bedrock: 'bedrock/anthropic.claude-3-5-sonnet-20240620-v1:0', 'bedrock/anthropic.claude-3-haiku-20240307-v1:0'
# Opciones Azure: 'azure/gpt-4o'
LLM_MODEL=bedrock/anthropic.claude-3-5-sonnet-20240620-v1:0

# Modo de simulacion: si es 'true', permite ejecutar escenarios completos sin credenciales activas de AWS
BEDROCK_MOCK=true

# Credenciales AWS (requeridas si BEDROCK_MOCK=false)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION_NAME=us-east-1

# Credenciales Azure (opcional para fallback)
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-02-01
